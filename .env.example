# LinkedIn collection scope
SEARCH_KEYWORDS=Data Scientist, Data Analyst
SEARCH_LOCATIONS=Berlin, Stuttgart, Frankfurt, München
SEARCH_TIME_RANGE=day
LINKEDIN_MAX_SEARCH_PAGES=4
REQUEST_DELAY=2.0
MAX_RETRIES=2

# Conservative title filtering. Academic and student roles are filtered by
# dedicated rules; keep this list for narrow personal exclusions.
UNWANTED_KEYWORDS=ai engineer,artificial intelligence engineer,generative ai engineer,genai engineer
UNWANTED_COMPANIES=

# Archive explicit exclusions and clearly unrelated roles during collection.
# Ambiguous/unmatched titles remain active for manual inspection.
RELEVANCE_MODE=enforce
ARCHIVE_UNMATCHED_JOBS=false

# Local API
API_TOKEN=
VITE_API_TOKEN=
VITE_API_BASE=/
APP_INSTANCE_NAME=job-informer-desktop
APP_TIMEZONE=Europe/Berlin

# Optional: compose uses /app/data/jobs.db by default.
# JOBS_DB_PATH=backend/data/jobs.db
