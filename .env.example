# Email Configuration
EMAIL_ADDRESS=
EMAIL_PASSWORD=
RECIPIENT_EMAIL=
OPENAI_API_KEY=

# Manual LinkedIn searches
SEARCH_KEYWORDS=Data Scientist, Data Analyst

# API auth (frontend and backend share this)
API_TOKEN=
VITE_API_TOKEN=
VITE_API_BASE=/
APP_INSTANCE_NAME=job-informer-desktop
APP_TIMEZONE=Europe/Berlin

# AI purge guardrails
AI_PURGE_MIN_CONFIDENCE=0.75
AI_PURGE_MAX_RATIO=0.35
# 0 = unlimited
AI_PURGE_MAX_JOBS=0

# LLM runtime controls
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.75
LLM_RETRY_MAX_DELAY=8.0
LLM_RETRY_JITTER=0.2

# Description parser quality controls
DESC_PARSER_MIN_CHARS=80
DESC_PARSER_MAX_CHARS=12000
ENABLE_DESCRIPTION_PARSER=false

SCRAPE_DESCRIPTIONS=false
SCRAPE_DESCRIPTIONS_LIMIT=20
ENABLE_LINKEDIN=true
LINKEDIN_MAX_SEARCH_PAGES=4
ENABLE_INDEED=false
INDEED_MAX_SEARCH_PAGES=0
INDEED_SESSION_COOKIES=

# Study-track and academic roles are handled by explicit rules. Keep this list
# for narrow personal exclusions only.
UNWANTED_KEYWORDS=ai engineer,artificial intelligence engineer,generative ai engineer,genai engineer

# Optional company-level blacklist for obvious aggregators or employers you never want.
UNWANTED_COMPANIES=

# Run DB cleanup before scraping. Safe now that hard filters are conservative.
AUTO_PURGE_BEFORE_SCRAPING=false

# Optional: override DB location (compose sets this to /app/data/jobs.db)
# JOBS_DB_PATH=backend/data/jobs.db
