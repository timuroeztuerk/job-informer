# Email Configuration
EMAIL_ADDRESS=
EMAIL_PASSWORD=
RECIPIENT_EMAIL=
OPENAI_API_KEY=

# API auth (frontend and backend share this)
API_TOKEN=
VITE_API_TOKEN=
VITE_API_BASE=/
APP_INSTANCE_NAME=job-informer-desktop
APP_TIMEZONE=Europe/Berlin

# AI purge guardrails
AI_PURGE_MIN_CONFIDENCE=0.75
AI_PURGE_MAX_RATIO=0.35
# 0 = unlimited
AI_PURGE_MAX_JOBS=0

# LLM runtime controls
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.75
LLM_RETRY_MAX_DELAY=8.0
LLM_RETRY_JITTER=0.2

# Description parser quality controls
DESC_PARSER_MIN_CHARS=80
DESC_PARSER_MAX_CHARS=12000

SCRAPE_DESCRIPTIONS=true
SCRAPE_DESCRIPTIONS_LIMIT=20
ENABLE_LINKEDIN=true
ENABLE_INDEED=false
INDEED_MAX_SEARCH_PAGES=0
INDEED_SESSION_COOKIES=

# Keep this conservative. Prefer only internship/student-study markers here.
UNWANTED_KEYWORDS=intern,internship,praktikant,praktikum,werkstudent,working student,student assistant,student helper,studentenjob,thesis,masterarbeit,masterthesis,bachelorarbeit,bachelorthesis,dissertation,doctoral,phd student,trainee,traineeship,ausbildung,duales studium,research assistant,hiwi

# Optional company-level blacklist for obvious aggregators or employers you never want.
UNWANTED_COMPANIES=

# Run DB cleanup before scraping. Safe now that hard filters are conservative.
AUTO_PURGE_BEFORE_SCRAPING=true

# Optional: override DB location (compose sets this to /app/data/jobs.db)
# JOBS_DB_PATH=backend/data/jobs.db
